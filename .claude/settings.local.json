{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m http.server 8080)",
      "Bash(netstat -ano)",
      "Bash(findstr :8080)",
      "Bash(npm run *)",
      "Bash(npx prisma *)",
      "mcp__playwright",
      "mcp__sequential-thinking",
      "mcp__shadcn"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ],
    "ask": [],
    "defaultMode": "plan" 
  },
  "enabledMcpjsonServers": [
    "memory",
    "github",
    "playwright"
  ],
  "enableAllProjectMcpServers": true,
  "plansDirectory": ".claude/plans/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Test Hooks!\" >> ./test-hooks-logs.txt"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify-permission.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify-stop.sh"
          }
        ]
      }
    ]
  }
}  